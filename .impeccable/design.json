   "html": "<button class=\"ds-tecla\">Ver detalle</button>",
   "css": ".ds-tecla{font:600 13px/1.1 system-ui,sans-serif;background:var(--surface-2,#1c2025);color:var(--ink,#eef0f3);border:1px solid var(--line,#2b3037);border-radius:4px;min-height:36px;padding:8px 13px;box-shadow:inset 0 1px 0 rgba(255,255,255,.05),inset 0 -1px 0 rgba(0,0,0,.4);transition:background 160ms cubic-bezier(.23,1,.32,1),transform 100ms cubic-bezier(.23,1,.32,1);cursor:pointer}.ds-tecla:hover{background:#252a31}.ds-tecla:focus-visible{outline:2px solid var(--accent,#4aa3ff);outline-offset:2px}.ds-tecla:active{transform:scale(.97)}"
  },
  {
   "name": "Tecla principal",
   "kind": "button",
   "refersTo": "button-tecla-go",
   "description": "La acción que toca ahora.",
   "html": "<button class=\"ds-tecla-go\">Grabar →</button>",
   "css": ".ds-tecla-go{font:600 13px/1.1 system-ui,sans-serif;background:var(--accent,#4aa3ff);color:var(--accent-ink,#04121f);border:1px solid var(--accent,#4aa3ff);border-radius:4px;min-height:36px;padding:8px 13px;transition:transform 100ms cubic-bezier(.23,1,.32,1);cursor:pointer}.ds-tecla-go:focus-visible{outline:2px solid #fff;outline-offset:2px}.ds-tecla-go:active{transform:scale(.97)}"
  },
