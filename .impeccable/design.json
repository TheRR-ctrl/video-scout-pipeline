   "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;font:600 10.5px/1 ui-monospace,monospace;letter-spacing:.07em;text-transform:uppercase;color:#a6aeb8;border:1px solid #2b3037;border-radius:3px;padding:4px 7px}.ds-pill::before{content:'';width:7px;height:7px;background:currentColor;opacity:.55}.ds-aire{color:#ff3b30;border-color:#ff3b30}.ds-aire::before{opacity:1;box-shadow:inset 0 0 0 1px rgba(255,255,255,.35)}"
