   "description": "Pestañas del panel como teclas de bus.",
   "html": "<nav class=\"ds-bus\"><button class=\"on\">Revisar <span>4</span></button><button>Cola <span>1</span></button><button>Ajustes</button></nav>",
   "css": ".ds-bus{display:flex;gap:8px;flex-wrap:wrap}.ds-bus button{font:400 17px/1 'Bebas Neue','Arial Narrow',sans-serif;letter-spacing:.07em;text-transform:uppercase;background:#1c2025;color:#a6aeb8;border:1px solid #2b3037;border-radius:4px;padding:9px 12px;cursor:pointer}.ds-bus button span{font:600 11px/1 ui-monospace,monospace;background:rgba(0,0,0,.28);padding:3px 5px;border-radius:3px;margin-left:6px}.ds-bus button.on{background:#4aa3ff;color:#04121f;border-color:#4aa3ff;box-shadow:inset 0 -3px 0 #3472b2}.ds-bus button:focus-visible{outline:2px solid #4aa3ff;outline-offset:2px}"
